// Diagram 5: Full Navigation State Machine
// Every tab, every transition, every keybinding — the complete picture.
//
// Render with: swgraph render graphviz_state_machine.gv

digraph full_nav {
    rankdir=LR;
    fontname="Helvetica";
    node [fontname="Helvetica", fontsize=10, style=filled, shape=box];
    edge [fontname="Helvetica", fontsize=8];
    splines=true;
    nodesep=0.8;
    ranksep=1.5;

    // ── Tab states ──────────────────────────────────────────────

    subgraph cluster_blocked {
        label="1. Blocked"; style=filled; fillcolor="#e3f2fd"; color="#1565C0";
        fontsize=11; fontname="Helvetica Bold";

        blocked [label="Blocked Tab\n\nListView of incidents\nTwo-axis selection\n(row + job group result)\n\nFilter: BLOCKED_SCHEMA\nKeybindings: / r b",
                 fillcolor="#bbdefb", color="#1565C0"];
    }

    subgraph cluster_incident {
        label="2. Incident"; style=filled; fillcolor="#fff3e0"; color="#FF9800";
        fontsize=11; fontname="Helvetica Bold";

        incident [label="Incident Tab\n\nMetadata header\nSummary line (enriched)\nJob group results\n\nFilter: INCIDENT_SCHEMA\nKeybindings: / r b",
                  fillcolor="#ffe0b2", color="#FF9800"];
    }

    subgraph cluster_jobgroup {
        label="3. Job Group"; style=filled; fillcolor="#e8f5e9"; color="#4CAF50";
        fontsize=11; fontname="Helvetica Bold";

        jobgroup [label="Job Group Tab\n\nDataTable of jobs\nResult|Test|Flavor|Arch\n\nFilter: JOBGROUP_SCHEMA\nKeybindings: / r b o",
                  fillcolor="#c8e6c9", color="#4CAF50"];
    }

    subgraph cluster_jobdetail {
        label="4. Job Detail"; style=filled; fillcolor="#f3e5f5"; color="#9C27B0";
        fontsize=11; fontname="Helvetica Bold";

        jobdetail [label="Job Detail Tab\n\nJob metadata view\nSettings, modules, logs\n\nFilter: (none)\nKeybindings: b o",
                   fillcolor="#e1bee7", color="#9C27B0"];
    }

    subgraph cluster_errors {
        label="5. Errors"; style=filled; fillcolor="#fce4ec"; color="#E91E63";
        fontsize=11; fontname="Helvetica Bold";

        errors [label="Errors Tab\n\nRichLog of WARNING+\nFooter: N new errors\n\nFilter: (none)\nKeybindings: (none)",
                fillcolor="#f8bbd0", color="#E91E63"];
    }

    // ── Start ───────────────────────────────────────────────────

    start [shape=circle, label="", width=0.3, fillcolor=black, color=black];
    start -> blocked [label="App launch\nfetch_bootstrap()\nthen fetch_blocked()",
                      fontsize=9, color="#333"];

    // ── Cross-tab drill-down (Enter) ────────────────────────────

    blocked -> incident [label="Enter\n(on row)\n\nIncidentSelected\nfilter: incident = N",
                         color="#FF9800", fontcolor="#E65100",
                         penwidth=2.5, style=bold];

    blocked -> jobgroup [label="Enter\n(on job group result)\n\nGroupSelected\nfilter: group_id = G\nAND incident = N",
                         color="#4CAF50", fontcolor="#1B5E20",
                         penwidth=2.5, style=bold];

    incident -> jobgroup [label="Enter\n(on job group result)\n\nGroupSelected\nfilter: group_id = G\nAND incident = N",
                          color="#4CAF50", fontcolor="#1B5E20",
                          penwidth=2.5, style=bold];

    jobgroup -> jobdetail [label="Enter\n(on table row)\n\nJobSelected\nfilter: job_id = J",
                           color="#9C27B0", fontcolor="#4A148C",
                           penwidth=2.5, style=bold];

    // ── Back navigation (b) ─────────────────────────────────────

    incident -> blocked [label="b", color="#90A4AE", fontcolor="#546E7A",
                         style=dashed, penwidth=1.5, constraint=false];

    jobgroup -> blocked [label="b", color="#90A4AE", fontcolor="#546E7A",
                         style=dashed, penwidth=1.5, constraint=false];

    jobdetail -> jobgroup [label="b", color="#90A4AE", fontcolor="#546E7A",
                           style=dashed, penwidth=1.5, constraint=false];

    // ── Tab cycling (Tab / Shift+Tab) ───────────────────────────
    //    _TAB_ORDER: blocked, incident, job-group, job-detail, errors

    blocked -> incident [label="Tab", color="#E0E0E0", fontcolor="#9E9E9E",
                         style=dotted, constraint=false];
    incident -> jobgroup [label="Tab", color="#E0E0E0", fontcolor="#9E9E9E",
                          style=dotted, constraint=false];
    jobgroup -> jobdetail [label="Tab", color="#E0E0E0", fontcolor="#9E9E9E",
                           style=dotted, constraint=false];
    jobdetail -> errors [label="Tab", color="#E0E0E0", fontcolor="#9E9E9E",
                         style=dotted, constraint=false];
    errors -> blocked [label="Tab\n(wraps)", color="#E0E0E0", fontcolor="#9E9E9E",
                       style=dotted, constraint=false];

    // ── Global keybindings ──────────────────────────────────────

    subgraph cluster_global_keys {
        label="Global Keybindings"; style=rounded; color="#BDBDBD";
        fontsize=10; labeljust=l;

        global [label="/  Focus filter bar (tabs with filter)\nr  Refresh current tab data\nb  Back to previous tab\no  Open in browser (Job Group, Job Detail)\nq  Quit application\nTab / Shift+Tab  Cycle tabs\n\nPlanned (not yet implemented):\n?  Help popup",
                shape=note, fillcolor="#FFFDE7", color="#F9A825",
                fontsize=9, fontname="Helvetica"];
    }

    // ── Legend ───────────────────────────────────────────────────

    subgraph cluster_legend {
        label="Legend"; style=rounded; color="#BDBDBD";
        fontsize=10; labeljust=l;

        leg1 [label="━━  Enter (drill-down)", shape=plaintext, fontsize=9];
        leg2 [label="- -  b (back)", shape=plaintext, fontsize=9];
        leg3 [label="···  Tab (cycle)", shape=plaintext, fontsize=9];

        leg1 -> leg2 -> leg3 [style=invis];
    }
}
